<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaModManager.Desktop"
             x:Class="RagnaModManager.Desktop.DiscoverView"
             x:DataType="local:DiscoverPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Discover" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Find community mods for Ragnarock and install them with one click." Foreground="#9AAAC2" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Refresh mod list" Classes="accent" Command="{Binding Refresh}" VerticalAlignment="Center"/></Grid>
      <Border Classes="card" Padding="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Search, Mode=TwoWay}" Watermark="Search community mods…" MinWidth="280" KeyDown="OnSearchKeyDown"/><Button Grid.Column="1" Content="Clear" Command="{Binding ClearSearch}"/></Grid>
      </Border>
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"><Button Content="Install selected" Classes="accent" Command="{Binding InstallSelected}"/><Button Content="Update all" Command="{Binding UpdateAll}"/></WrapPanel>
      <TextBlock Text="{Binding Status}" Foreground="#9AAAC2" TextWrapping="Wrap"/>
      <Border Classes="card" Padding="10">
        <Grid ColumnDefinitions="28,Auto,2*,3*,120,140,220" ColumnSpacing="8"><TextBlock Grid.Column="1" Text="All" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Mod" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Description" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Latest" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="Installed" FontWeight="SemiBold"/><TextBlock Grid.Column="6" Text="Actions" FontWeight="SemiBold"/></Grid>
      </Border>
      <ListBox ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:DiscoverModViewModel">
            <Border Classes="card" Margin="0,0,0,8" Padding="10">
              <Grid ColumnDefinitions="28,Auto,2*,3*,120,140,220" ColumnSpacing="8">
                <CheckBox Grid.Column="1" IsChecked="{Binding Selected, Mode=TwoWay}" Command="{Binding ToggleSelected}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="3" Text="{Binding Description}" Foreground="#9AAAC2" TextWrapping="Wrap" MaxHeight="48"/>
                <TextBlock Grid.Column="4" Text="{Binding Latest}" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="5" Text="{Binding Installed}" Foreground="{Binding InstalledBrush}" VerticalAlignment="Top"/>
                <WrapPanel Grid.Column="6" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"><ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}" MinWidth="100"/><Button Content="Install" Command="{Binding Install}"/><Button Content="Details" Command="{Binding Details}"/></WrapPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Classes="empty" IsVisible="{Binding IsEmpty}" Padding="32"><StackPanel Spacing="8" HorizontalAlignment="Center"><TextBlock Text="No community mods match this search." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Try another name or refresh the catalog." Opacity="0.6" HorizontalAlignment="Center"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
