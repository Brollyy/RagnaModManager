<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaModManager.Desktop"
             x:Class="RagnaModManager.Desktop.DashboardView"
             x:DataType="local:DashboardViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <TextBlock Text="Your session" FontSize="24" FontWeight="SemiBold" />
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Headline}" Foreground="{Binding HeadlineBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding NextSteps}" Foreground="#9AAAC2" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
        <Border Grid.Column="0" Classes="metric" Padding="16">
          <StackPanel Spacing="4"><TextBlock Text="SETUP" Classes="eyebrow"/><TextBlock Text="{Binding SetupName}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Your current setup" Foreground="#9AAAC2"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="metric" Padding="16">
          <StackPanel Spacing="4"><TextBlock Text="ACTIVE MODS" Classes="eyebrow"/><TextBlock Text="{Binding ActiveMods}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding InstalledMods}" Foreground="#9AAAC2"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="metric" Padding="16">
          <StackPanel Spacing="4"><TextBlock Text="PLAY STATUS" Classes="eyebrow"/><TextBlock Text="{Binding PlayStatus}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding PlayDetail}" Foreground="#9AAAC2" TextWrapping="Wrap"/></StackPanel>
        </Border>
      </Grid>
      <Border Classes="card" Padding="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="5"><TextBlock Text="Start here" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choose a game folder, add a mod, or open your library." Foreground="#9AAAC2" TextWrapping="Wrap"/></StackPanel>
          <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
            <Button Content="Set up automatically" Classes="accent" IsVisible="{Binding ShowSetupAction}" Command="{Binding SetupAutomatically}" />
            <Button Content="Add a mod" Classes="accent" Command="{Binding AddMod}" />
            <Button Content="Open game folder" Command="{Binding OpenGameFolder}" />
            <Button Content="Open mod library" Command="{Binding OpenModLibrary}" />
          </WrapPanel>
        </Grid>
      </Border>
      <Border Classes="card" IsVisible="{Binding ShowDeploymentNotice}" Padding="16">
        <StackPanel Spacing="6"><TextBlock Text="Before you play" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding DeploymentMessage}" TextWrapping="Wrap"/><TextBlock Text="{Binding DeploymentDetails}" Foreground="#9AAAC2" TextWrapping="Wrap"/></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
