<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaModManager.Desktop"
             x:Class="RagnaModManager.Desktop.ConfirmDialog"
             x:DataType="local:ConfirmDialogViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="14">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /></ScrollViewer>
    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" ItemSpacing="8">
      <Button Content="Cancel" Command="{Binding Cancel}" />
      <Button Content="{Binding ConfirmText}" Classes="accent" Command="{Binding Confirm}" />
    </WrapPanel>
  </Grid>
</UserControl>
