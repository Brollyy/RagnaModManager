<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaModManager.Desktop"
             x:Class="RagnaModManager.Desktop.DetailsDialog"
             x:DataType="local:DetailsDialogViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="14">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /></ScrollViewer>
    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" ItemSpacing="8">
      <Button Content="Open source link" IsVisible="{Binding HasSource}" Command="{Binding OpenSource}" />
      <Button Content="Close" Classes="accent" Command="{Binding Close}" />
    </WrapPanel>
  </Grid>
</UserControl>
