<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaModManager.Desktop"
             x:Class="RagnaModManager.Desktop.SettingsView"
             x:DataType="local:SettingsPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <TextBlock Text="Get Ragnarock ready" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Intro}" Foreground="#9AAAC2" TextWrapping="Wrap"/>
      <Border Classes="card" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Connect Ragnarock" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding GameStatus}" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding GamePath, Mode=TwoWay}" Watermark="/path/to/steamapps/common/Ragnarock"/><WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6"><Button Content="Choose folder" Command="{Binding BrowseGame}"/><Button Content="Find automatically" Command="{Binding DetectGame}"/><Button Content="Save folder" Classes="accent" Command="{Binding SaveGame}"/></WrapPanel></Grid></StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Apply your mod setup" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ApplyStatus}" TextWrapping="Wrap"/><TextBlock Text="Applying updates the files this app manages. Other game files are left alone." Foreground="#9AAAC2" TextWrapping="Wrap"/><WrapPanel Orientation="Horizontal" ItemSpacing="8"><Button Content="Apply setup" Classes="accent" IsEnabled="{Binding CanApplySetup}" Command="{Binding ApplySetup}"/><Button Content="Clean up extra files" IsEnabled="{Binding CanCleanUp}" Command="{Binding CleanUp}"/></WrapPanel></StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Support for script-based mods" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SupportStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding SupportNote}" Foreground="#9AAAC2" TextWrapping="Wrap"/><WrapPanel Orientation="Horizontal" ItemSpacing="8"><Button Content="Check for support updates" Classes="accent" IsEnabled="{Binding CanUseSupport}" Command="{Binding CheckSupport}"/><Button Content="Install support from file" IsEnabled="{Binding CanUseSupport}" Command="{Binding InstallSupport}"/></WrapPanel><WrapPanel Orientation="Horizontal" ItemSpacing="8" IsVisible="{Binding HasCachedSupport}"><ComboBox ItemsSource="{Binding CachedSupportVersions}" SelectedItem="{Binding SelectedCachedSupport, Mode=TwoWay}" MinWidth="280"/><Button Content="Use saved support version" IsEnabled="{Binding CanUseSupport}" Command="{Binding UseCachedSupport}"/></WrapPanel></StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Undo or repair changes" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding RecoverySummary}" TextWrapping="Wrap"/><TextBlock Text="These actions affect files applied by this app. They do not touch unrelated game files." Foreground="#9AAAC2" TextWrapping="Wrap"/><WrapPanel Orientation="Horizontal" ItemSpacing="8"><Button Content="Undo last change" IsEnabled="{Binding CanRecover}" Command="{Binding Rollback}"/><Button Content="Remove applied setup" IsEnabled="{Binding CanRecover}" Command="{Binding ResetDeployment}"/></WrapPanel></StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Advanced launch options" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Most players can leave this empty. Steam launches ignore these options." Foreground="#9AAAC2" TextWrapping="Wrap"/><WrapPanel Orientation="Horizontal" ItemSpacing="8"><TextBox Text="{Binding LaunchArguments, Mode=TwoWay}" Watermark="Optional launch arguments" MinWidth="420"/><Button Content="Save launch options" Command="{Binding SaveLaunchOptions}"/></WrapPanel></StackPanel></Border>
      <Border Classes="card" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Troubleshooting" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Open the logs when support asks for them, or report a problem on GitHub." Foreground="#9AAAC2" TextWrapping="Wrap"/><WrapPanel Orientation="Horizontal" ItemSpacing="8"><Button Content="Open app logs" Command="{Binding OpenLogs}"/><Button Content="Report a problem on GitHub" Classes="accent" Command="{Binding OpenIssues}"/></WrapPanel></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
