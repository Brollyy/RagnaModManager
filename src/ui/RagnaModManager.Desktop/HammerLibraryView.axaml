<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaModManager.Desktop"
             x:Class="RagnaModManager.Desktop.HammerLibraryView"
             x:DataType="local:HammerLibraryPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Hammer Library" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CountLabel}" Foreground="#4DE1C1" />
          <TextBlock Text="Keep custom hammers together and build one game-matched package. Each hammer needs cooked mesh and data assets plus a unique DataTable row name." Foreground="#9AAAC2" TextWrapping="Wrap" MaxWidth="760" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Import .rhammer package" Classes="accent" Padding="14,9" Command="{Binding Import}" />
            <Button Content="Choose local AES key file" Padding="14,9" Command="{Binding ChooseKeyFile}" />
            <Button Content="{Binding BuildLabel}" Padding="14,9" IsEnabled="{Binding CanBuild}" Command="{Binding Build}" />
            <Button Content="Open library folder" Padding="14,9" Command="{Binding OpenFolder}" />
          </WrapPanel>
          <Border Background="#17243B" BorderBrush="#2A3A55" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Text="Installed build" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding GameBuild}" Foreground="#4DE1C1" />
              <TextBlock Grid.Row="1" Text="Build status" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildStatus}" Foreground="#FFB15C" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="18" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="8">
          <TextBlock Text="Your hammer library is empty" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Import a cooked .rhammer package to add a model. Packages are checked for unique row names, valid game asset paths, and required mesh and data assets." Foreground="#9AAAC2" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:HammerLibraryRowViewModel">
            <Border Classes="card" Padding="14" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version}" Foreground="#9AAAC2" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Foreground="#9AAAC2" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Author}" Foreground="#71829D" />
                  <TextBlock Text="{Binding RowName}" FontFamily="monospace" FontSize="12" />
                  <TextBlock Text="{Binding MeshAssetPath}" Foreground="#71829D" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" Command="{Binding ToggleEnabled}" />
                  <Button Content="Remove" Classes="destructive" Padding="12,8" Command="{Binding Remove}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
