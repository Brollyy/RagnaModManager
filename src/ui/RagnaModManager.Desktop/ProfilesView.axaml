<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RagnaModManager.Desktop"
             x:Class="RagnaModManager.Desktop.ProfilesView"
             x:DataType="local:ProfilesPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <TextBlock Text="Setups" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Save different groups of mods for different ways to play." TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,-15">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ProfileRowViewModel">
            <Border Classes="card" Margin="0,0,0,10" Padding="16,15"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBox Height="35" Text="{Binding Name, Mode=TwoWay}" MinWidth="220"/><Button Width="80" Height="35" Margin="0,1,0,1" Padding="12,8" HorizontalContentAlignment="Center" Content="Rename" Command="{Binding Rename}"/></StackPanel><TextBlock Margin="0,-1,0,1" Text="{Binding Summary}" Foreground="#9AAAC2" TextWrapping="Wrap"/></StackPanel><WrapPanel Grid.Column="1" Margin="0,-9,10,0" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center"><Button Width="68" Padding="12,8" Content="Active" IsVisible="{Binding IsActive}" IsEnabled="False"/><Button Padding="12,8" Content="Use setup" IsVisible="{Binding IsInactive}" Command="{Binding Use}"/><Button Width="89" Padding="12,8" Content="Duplicate" Command="{Binding Duplicate}"/><Button Width="69" Padding="12,8" Content="Delete" Command="{Binding Delete}" IsEnabled="{Binding IsInactive}"/></WrapPanel></Grid></Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card" Margin="0,1,0,-5" Padding="16,16,16,17"><StackPanel Spacing="10"><TextBlock Text="Create another setup" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Save a different group of mods for another kind of play session."/><WrapPanel Margin="0,0,0,9" Orientation="Horizontal" ItemSpacing="10" VerticalAlignment="Center"><TextBox Height="35" Text="{Binding NewName, Mode=TwoWay}" Watermark="Name this setup" MinWidth="240"/><Button Height="35" Padding="12,8" HorizontalContentAlignment="Center" FontWeight="SemiBold" Content="Create setup" Classes="accent" Command="{Binding Create}"/></WrapPanel></StackPanel></Border>
      <Border Classes="card" Margin="0,1,0,0" Padding="16,16,16,16"><StackPanel Spacing="10"><TextBlock Text="Share or back up setups" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Save this setup to a file, or bring one in from another installation."/><WrapPanel Orientation="Horizontal" ItemSpacing="10" VerticalAlignment="Center"><Button Height="35" Padding="12,8" Content="Export setup" Command="{Binding Export}"/><Button Height="35" Padding="12,8" Content="Import setup" Command="{Binding Import}"/></WrapPanel></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
