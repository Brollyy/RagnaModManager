<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RagnaModManager.Desktop"
        x:Class="RagnaModManager.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1240"
        Height="820"
        MinWidth="900"
        MinHeight="640">
  <Window.DataTemplates>
    <DataTemplate x:DataType="local:DashboardViewModel"><local:DashboardView /></DataTemplate>
    <DataTemplate x:DataType="local:DiscoverPageViewModel"><local:DiscoverView /></DataTemplate>
    <DataTemplate x:DataType="local:ModsPageViewModel"><local:ModsView /></DataTemplate>
    <DataTemplate x:DataType="local:ProfilesPageViewModel"><local:ProfilesView /></DataTemplate>
    <DataTemplate x:DataType="local:HammerLibraryPageViewModel"><local:HammerLibraryView /></DataTemplate>
    <DataTemplate x:DataType="local:SettingsPageViewModel"><local:SettingsView /></DataTemplate>
  </Window.DataTemplates>
  <Window.Styles>
    <Style Selector="TabItem.active-tab">
      <Setter Property="Background" Value="#173D3D" />
      <Setter Property="Foreground" Value="#4DE1C1" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#205A55" />
      <Setter Property="BorderBrush" Value="#2A766E" />
      <Setter Property="Foreground" Value="#E8F7F4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent:pointerover">
      <Setter Property="Background" Value="#286A63" />
      <Setter Property="BorderBrush" Value="#3A887E" />
      <Setter Property="Foreground" Value="#F2FBF9" />
    </Style>
    <Style Selector="Button.accent:pressed">
      <Setter Property="Background" Value="#194B47" />
      <Setter Property="BorderBrush" Value="#286A63" />
    </Style>
  </Window.Styles>
  <DockPanel x:Name="ShellRoot" Margin="24">
    <Border DockPanel.Dock="Top"
            Background="#111B2E"
            BorderBrush="#2A3A55"
            BorderThickness="1"
            CornerRadius="14"
            BoxShadow="0 4 12 0 #15000000"
            Padding="22"
            Margin="0,0,0,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="Ragna Mod Manager" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="Pick a setup, switch mods on, and play." Foreground="#9AAAC2" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CurrentSetupLabel}" Foreground="#4DE1C1" FontSize="12" />
          <TextBlock Text="{Binding VersionLabel}" Foreground="#71829D" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ComboBox x:Name="LaunchModeSelector"
                    MinWidth="100"
                    VerticalAlignment="Center" />
          <Button x:Name="LaunchButton"
                  Content="Launch Ragnarock"
                  Classes="accent"
                  VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="PendingChangesBar" DockPanel.Dock="Bottom" IsVisible="{Binding HasPendingChanges}" Background="#3B2D1B" BorderBrush="#FFB15C" BorderThickness="1" CornerRadius="6" Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="This setup has unapplied changes." FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="ApplyChangesButton" Padding="12,8" FontWeight="SemiBold" Content="Apply changes" Classes="accent" Command="{Binding ApplyChanges}" />
        <Button x:Name="RevertChangesButton" Padding="12,8" Content="Revert changes" Command="{Binding RevertChanges}" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="4,12,4,0" Foreground="#9AAAC2" TextWrapping="Wrap" />
    <TabControl x:Name="NavigationTabs"
                TabStripPlacement="Left"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                SizeChanged="OnNavigationSizeChanged">
      <TabItem Header="HOME"><ContentControl Content="{Binding Dashboard}" /></TabItem>
      <TabItem Header="DISCOVER"><ContentControl Content="{Binding Discover}" /></TabItem>
      <TabItem Header="MODS"><ContentControl Content="{Binding Mods}" /></TabItem>
      <TabItem Header="SETUPS"><ContentControl Content="{Binding Profiles}" /></TabItem>
      <TabItem Header="SETTINGS"><ContentControl Content="{Binding Settings}" /></TabItem>
      <TabItem Header="HAMMERS"><ContentControl Content="{Binding Hammers}" /></TabItem>
    </TabControl>
  </DockPanel>
</Window>
